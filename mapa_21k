  {name:"MITJA DE BALAGUER",loc:"Balaguer",dist:"21k · 10k · 5k",date:"07/03",month:"Marzo",doy:66,confirmed:false,web:"https://www.runners.cat/",guideUrl:"https://wp.me/pNuBu-gma",lat:41.7833,lng:0.8167},
