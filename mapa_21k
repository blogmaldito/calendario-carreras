  {name:"MITJA DE MONTORNÈS",loc:"Montornès",dist:"21k · 6k",date:"11/04",month:"Abril",doy:101,confirmed:false,web:"https://mitjamontornes.com/",guideUrl:"https://wp.me/pNuBu-nPO",lat:41.55,lng:2.2667},
  {name:"MITJA D'EMPÚRIES",loc:"L'Escala",dist:"21k · 42k · 10k ·5k",date:"18/04",month:"Abril",doy:108,confirmed:false,web:"https://esportslescala.cat/marato-dempuries/",guideUrl:"",lat:42.1167,lng:3.1333},
  {name:"MITJA DEL MEDITERRANI",loc:"Castelldefels",dist:"21k · 10k · 5k",date:"25/04",month:"Abril",doy:115,confirmed:true,web:"https://www.zonavipevents.com/marato-del-mediterrani/",guideUrl:"https://wp.me/pNuBu-qN3",lat:41.2833,lng:1.9667},
  {name:"MITJA MARATÓ VIES VERDES",loc:"Girona / Platja D'Aro",dist:"42k · 30k · 21k · 10k",date:"25/04",month:"Abril",doy:115,confirmed:false,web:"https://maratonviasverdes.com/ca/girona",guideUrl:"",lat:41.8167,lng:3.0},
  {name:"MITJA DE TÀRREGA",loc:"Tàrrega",dist:"21k · 10k",date:"09/05",month:"Mayo",doy:129,confirmed:false,web:"https://fondistestarrega.com/ca/pc/2-mitja-marato-i-10-km-ciutat-de-tarrega",guideUrl:"https://wp.me/pNuBu-o1H",lat:41.65,lng:1.15},
  {name:"21K LO CARO",loc:"Tortosa",dist:"21k ·10k",date:"16/05",month:"Mayo",doy:136,confirmed:false,web:"http://www.21kloport.cat/es/inicio/",guideUrl:"",lat:40.8167,lng:0.5167},
  {name:"RUN FESTIVAL TOSSA DE MAR",loc:"Tossa de Mar",dist:"21k · 42k · 10k ·5k",date:"16/05",month:"Mayo",doy:136,confirmed:true,web:"https://runfestivaltossa.com/",guideUrl:"https://wp.me/pNuBu-l6k",lat:41.7167,lng:2.9333},
  {name:"MITJA RURAL DE REUS",loc:"Reus",dist:"21k · 10k",date:"30/05",month:"Mayo",doy:150,confirmed:false,web:"https://webtretzesports.wixsite.com/mitjaruralreus",guideUrl:"",lat:41.15,lng:1.1}
];

const MONTH_LABELS=['','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
function doyToLabel(doy){
  if(doy>=366) return '31 Dic';
  if(doy<=1) return '1 Ene';
  const md=[0,31,28,31,30,31,30,31,31,30,31,30,31];
  let m=1,d=doy;
  while(m<=12&&d>md[m]){d-=md[m];m++;}
  return m>12?'31 Dic':`${d} ${MONTH_LABELS[m]}`;
}

const map=L.map('map').setView([41.7,1.8],8);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
  attribution:'© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',maxZoom:19
}).addTo(map);
setTimeout(()=>{
  document.querySelectorAll('.leaflet-tile-pane').forEach(el=>{el.style.filter='grayscale(100%) brightness(1.05)';});
},400);

let sliderMin=1,sliderMax=366,searchFilter=null;
let markersLayer=L.layerGroup().addTo(map);

const sMin=document.getElementById('slider-min');
const sMax=document.getElementById('slider-max');
const sFill=document.getElementById('slider-fill');

function updateSlider(){
  const p1=(sliderMin-1)/365*100,p2=(sliderMax-1)/365*100;
  sFill.style.left=p1+'%';sFill.style.width=(p2-p1)+'%';
  document.getElementById('slider-label').textContent=
    (sliderMin===1&&sliderMax===366)?'Busca por fecha':doyToLabel(sliderMin)+' -&gt; '+doyToLabel(sliderMax);
  renderMarkers();
}
sMin.addEventListener('input',()=>{sliderMin=Math.min(+sMin.value,sliderMax-1);sMin.value=sliderMin;updateSlider();});
sMax.addEventListener('input',()=>{sliderMax=Math.max(+sMax.value,sliderMin+1);sMax.value=sliderMax;updateSlider();});

function onSearchInput(){
  const q=document.getElementById('search-input').value.toLowerCase().trim();
  document.getElementById('search-clear').style.display=q?'block':'none';
  if(!q){searchFilter=null;hideDropdown();renderMarkers();return;}
  const matches=RACES.filter(r=>r.name.toLowerCase().includes(q)||r.loc.toLowerCase().includes(q));
  showDropdown(matches);
}
function onSearchFocus(){
  if(!document.getElementById('search-input').value.trim()) showDropdown(RACES.slice(0,12));
}
function onSearchBlur(){setTimeout(hideDropdown,200);}
function showDropdown(items){
  const dd=document.getElementById('search-dropdown');
  if(!items.length){dd.innerHTML='<div class="search-item" style="color:#aaa">Sin resultados</div>';dd.classList.add('visible');return;}
  dd.innerHTML=items.slice(0,15).map(r=>
    `<div class="search-item" onmousedown="selectRace('${r.name.replace(/'/g,"\\'")}')">${r.name} <span style="color:#aaa;font-size:10px">· ${r.loc}</span></div>`
  ).join('');
  dd.classList.add('visible');
}
function hideDropdown(){document.getElementById('search-dropdown').classList.remove('visible');}
function selectRace(name){
  searchFilter=name;
  document.getElementById('search-input').value=name;
  document.getElementById('search-clear').style.display='block';
  hideDropdown();
  renderMarkers();
  const r=RACES.find(r=>r.name===name);
  if(r) map.setView([r.lat,r.lng],13);
}
function clearSearch(){
  searchFilter=null;
  document.getElementById('search-input').value='';
  document.getElementById('search-clear').style.display='none';
  renderMarkers();
}

function makeIcon(confirmed){
  const bg=confirmed?'#4a7c59':'#c47c3e';
  return L.divIcon({
    html:`<div style="width:20px;height:20px;background:${bg};border-radius:50%;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3)"></div>`,
    iconSize:[20,20],iconAnchor:[10,10],className:''
  });
}

function renderMarkers(){
  markersLayer.clearLayers();
  const fr=RACES.filter(r=>{
    const dateOk=r.doy>=sliderMin&&r.doy<=sliderMax;
    const searchOk=!searchFilter||r.name===searchFilter;
    return dateOk&&searchOk;
  });
  const jitter=()=>(Math.random()-0.5)*0.004;
  fr.forEach(r=>{
    const marker=L.marker([r.lat+jitter(),r.lng+jitter()],{icon:makeIcon(r.confirmed)});
    marker.bindPopup(`<div style="min-width:200px;max-width:260px">
      <div class="popup-title">${r.name}</div>
      <div class="popup-sub">${r.loc} · ${r.date} · ${r.month}</div>
      <div style="font-size:11px;color:#777;margin-bottom:4px">${r.dist}</div>
      ${r.web?`<a class="popup-link" href="${r.web}" target="_blank" rel="noopener"> Web oficial</a>`:''}
      ${r.guideUrl?`<a class="popup-guide" href="${r.guideUrl}" target="_blank" rel="noopener">Guia del corredor </a>`:''}
    </div>`,{maxWidth:280});
    markersLayer.addLayer(marker);
  });
  document.getElementById('stats').innerHTML=`<strong>${fr.length}</strong> mitges`;
}

updateSlider();
</script>
</body>
</html>
