<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mapa Mitges Maratons Catalunya 2026</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;height:100vh;display:flex;flex-direction:column}
.topbar{background:#fff;border-bottom:1px solid #e0e0e0;padding:10px 14px;flex-shrink:0}
.topbar-row1{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px}
.map-title{font-size:15px;font-weight:600;color:#111}
.search-wrap{position:relative;flex:1;max-width:220px}
.search-input{width:100%;font-size:12px;padding:5px 10px 5px 28px;border:1px solid #ddd;border-radius:20px;outline:none;color:#333}
.search-input:focus{border-color:#888}
.search-icon{position:absolute;left:9px;top:50%;transform:translateY(-50%);color:#aaa;font-size:13px;pointer-events:none}
.search-dropdown{position:absolute;top:calc(100% + 4px);left:0;right:0;background:#fff;border:1px solid #ddd;border-radius:8px;box-shadow:0 4px 12px rgba(0,0,0,.12);z-index:2000;max-height:200px;overflow-y:auto;display:none}
.search-dropdown.visible{display:block}
.search-item{padding:7px 12px;font-size:12px;cursor:pointer;color:#333}
.search-item:hover{background:#f5f5f5}
.search-clear{position:absolute;right:9px;top:50%;transform:translateY(-50%);color:#aaa;cursor:pointer;font-size:14px;display:none}
.map-stats{font-size:11px;color:#aaa;margin-left:auto}
.map-stats strong{color:#555}
.slider-row{display:flex;align-items:center;gap:10px}
.slider-label{font-size:11px;color:#888;white-space:nowrap;min-width:100px}
.slider-wrap{flex:1;position:relative;height:20px}
.slider-track{position:absolute;top:8px;left:0;right:0;height:4px;background:#e0e0e0;border-radius:2px}
.slider-fill{position:absolute;top:8px;height:4px;background:#444;border-radius:2px}
input[type=range]{position:absolute;width:100%;height:4px;top:8px;left:0;appearance:none;background:transparent;pointer-events:none}
input[type=range]::-webkit-slider-thumb{appearance:none;width:16px;height:16px;border-radius:50%;background:#222;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.3);pointer-events:all;cursor:pointer}
#map{flex:1}
.legend{position:absolute;bottom:24px;left:10px;z-index:1000;background:rgba(255,255,255,.95);padding:8px 12px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.12);font-size:11px}
.legend-item{display:flex;align-items:center;gap:6px;margin-bottom:3px;color:#555}
.legend-item:last-child{margin-bottom:0}
.legend-dot{width:9px;height:9px;border-radius:50%}
.popup-title{font-size:13px;font-weight:600;color:#111;margin-bottom:3px}
.popup-sub{font-size:11px;color:#888;margin-bottom:5px}
.popup-link{display:block;font-size:11px;color:#1565c0;margin-top:4px;text-decoration:none}
.popup-link:hover{text-decoration:underline}
.popup-guide{display:inline-block;font-size:11px;font-weight:600;color:#2e7d32;background:#e8f5e9;padding:2px 8px;border-radius:8px;margin-top:6px;text-decoration:none}
.popup-guide:hover{background:#c8e6c9}
</style>
</head>
<body>
<div class="topbar">
  <div class="topbar-row1">
    <span class="map-title">Mitges Maratons Catalunya 2026</span>
    <div class="search-wrap">
      <span class="search-icon">🔍</span>
      <input class="search-input" id="search-input" type="text" placeholder="Buscar carrera..."
        oninput="onSearchInput()" onfocus="onSearchFocus()" onblur="onSearchBlur()">
      <span class="search-clear" id="search-clear" onclick="clearSearch()">✕</span>
      <div class="search-dropdown" id="search-dropdown"></div>
    </div>
    <span class="map-stats" id="stats"></span>
  </div>
  <div class="slider-row">
    <span class="slider-label" id="slider-label">Busca por fecha</span>
    <div class="slider-wrap">
      <div class="slider-track"></div>
      <div class="slider-fill" id="slider-fill"></div>
      <input type="range" id="slider-min" min="1" max="366" value="1">
      <input type="range" id="slider-max" min="1" max="366" value="366">
    </div>
  </div>
</div>
<div id="map" style="position:relative">
  <div class="legend">
    <div class="legend-item"><div class="legend-dot" style="background:#4a7c59"></div>Confirmada</div>
    <div class="legend-item"><div class="legend-dot" style="background:#c47c3e"></div>Pendiente</div>
  </div>
</div>

