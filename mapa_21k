  {name:"MITJA BADIA DE ROSES",loc:"Roses",dist:"21k · 7,5k",date:"03/01",month:"Enero",doy:3,confirmed:false,web:"https://www.atletismeroses.cat/mitjabadiaderoses",guideUrl:"",lat:42.2667,lng:3.1833},
