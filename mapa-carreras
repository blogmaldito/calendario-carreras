function updateSliderFill() {
  const pct1 = (sliderMin-1)/365*100;
  const pct2 = (sliderMax-1)/365*100;
  sFill.style.left = pct1+'%';
  sFill.style.width = (pct2-pct1)+'%';
  const label = document.getElementById('slider-label');
  if(sliderMin===1 && sliderMax===366) {
    label.textContent = 'Busca por fecha';
  } else {
    label.textContent = doyToLabel(sliderMin) + ' → ' + doyToLabel(sliderMax);
  }
  renderMarkers();
}

sMin.addEventListener('input', () => {
  sliderMin = Math.min(parseInt(sMin.value), sliderMax-1);
  sMin.value = sliderMin;
  updateSliderFill();
});
sMax.addEventListener('input', () => {
  sliderMax = Math.max(parseInt(sMax.value), sliderMin+1);
  sMax.value = sliderMax;
  updateSliderFill();
});
updateSliderFill();

// Filter races
function filteredRaces() {
  return RACES.filter(r => r.doy >= sliderMin && r.doy <= sliderMax);
}

// Icons
function makeIcon(confirmed, count) {
  const bg = confirmed ? '#4a7c59' : '#bbb';
  const s = count > 9 ? 34 : count > 4 ? 30 : count > 1 ? 26 : 22;
  const badge = count > 1 ? `<div style="position:absolute;top:-7px;right:-7px;background:#e65100;color:#fff;font-size:9px;font-weight:700;border-radius:50%;width:15px;height:15px;display:flex;align-items:center;justify-content:center;line-height:1">${count}</div>` : '';
  return L.divIcon({
    html: `<div style="position:relative;width:${s}px;height:${s}px;background:${bg};border-radius:50%;border:2.5px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.25)">${badge}</div>`,
    iconSize:[s,s], iconAnchor:[s/2,s/2], className:''
  });
}

function makePopupLoc(loc, rs) {
  const rows = rs.map(r =>
    `<div class="popup-race">
      <div class="popup-dot" style="background:${r.confirmed?'#4a7c59':'#bbb'}"></div>
      <span class="popup-rname">${r.name}</span>
      <span class="popup-date">${r.date}</span>
      <span class="popup-dist">${r.dist}</span>
    </div>`
  ).join('');
  const links = rs.filter(r=>r.web).map(r=>
    `<a class="popup-link" href="${r.web}" target="_blank">↗ ${r.name}</a>`
  ).join('');
  return `<div style="min-width:210px;max-width:270px">
    <div class="popup-title">${loc}</div>
    <div class="popup-sub">${rs.length} carrera${rs.length>1?'s':''}</div>
    ${rows}${links}
  </div>`;
}

function renderMarkers() {
  markersLayer.clearLayers();
  const fr = filteredRaces();

  if(mode === 'locality') {
    const byLoc = {};
    fr.forEach(r => { if(!byLoc[r.loc])byLoc[r.loc]=[]; byLoc[r.loc].push(r); });
    let shown = 0;
    Object.entries(byLoc).forEach(([loc, rs]) => {
      const allConf = rs.every(r=>r.confirmed);
      const c = getCoord(rs[0]);
      const marker = L.marker(c, {
        icon: makeIcon(allConf, rs.length),
        draggable: editMode
      });
      marker.bindPopup(makePopupLoc(loc, rs), {maxWidth:290});
      if(editMode) {
        marker.on('click', () => selectMarker(marker, loc));
        marker.on('dragend', () => {
          const p = marker.getLatLng();
          savedCoords[loc] = [+p.lat.toFixed(5), +p.lng.toFixed(5)];
          localStorage.setItem('map_coords', JSON.stringify(savedCoords));
          updateEditPanel(loc, savedCoords[loc]);
        });
      }
      markersLayer.addLayer(marker);
      shown++;
    });
    document.getElementById('stats').innerHTML = `<strong>${shown}</strong> localidades · <strong>${fr.length}</strong> carreras`;
  } else {
    const jitter = () => (Math.random()-0.5)*0.006;
    fr.forEach(r => {
      const c = getCoord(r);
      const marker = L.marker([c[0]+jitter(), c[1]+jitter()], {
        icon: makeIcon(r.confirmed, 1),
        draggable: editMode
      });
      marker.bindPopup(`<div style="min-width:190px">
        <div class="popup-title">${r.name}</div>
        <div class="popup-sub">${r.loc} · ${r.date} · ${r.month}</div>
        <div style="margin-top:5px;font-size:11px;color:#777">${r.dist}</div>
        ${r.web?`<a class="popup-link" href="${r.web}" target="_blank">↗ Web oficial</a>`:''}
      </div>`, {maxWidth:280});
      if(editMode) {
        marker.on('click', () => selectMarker(marker, r.loc));
        marker.on('dragend', () => {
          const p = marker.getLatLng();
          savedCoords[r.loc] = [+p.lat.toFixed(5), +p.lng.toFixed(5)];
          localStorage.setItem('map_coords', JSON.stringify(savedCoords));
          updateEditPanel(r.loc, savedCoords[r.loc]);
        });
      }
      markersLayer.addLayer(marker);
    });
    document.getElementById('stats').innerHTML = `<strong>${fr.length}</strong> carreras`;
  }
}

function setMode(m) {
  mode = m;
  document.getElementById('btn-loc').classList.toggle('active', m==='locality');
  document.getElementById('btn-race').classList.toggle('active', m==='race');
  renderMarkers();
}

function toggleEdit() {
  editMode = !editMode;
  const btn = document.getElementById('edit-btn');
  const panel = document.getElementById('edit-panel');
  btn.classList.toggle('active', editMode);
  btn.textContent = editMode ? '✓ Salir de edición' : '✎ Mover pines';
  panel.classList.toggle('visible', editMode);
  renderMarkers();
}

function selectMarker(marker, loc) {
  selectedMarker = {marker, loc};
  const c = marker.getLatLng();
  updateEditPanel(loc, [c.lat, c.lng]);
}

function updateEditPanel(loc, coords) {
  document.getElementById('edit-coords').textContent =
    `"${loc}": [${coords[0]}, ${coords[1]}]`;
}

function copyCoords() {
  const text = document.getElementById('edit-coords').textContent;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.querySelector('.btn-copy');
    btn.textContent = '✓ Copiado';
    setTimeout(() => btn.textContent = 'Copiar coordenadas', 2000);
  });
}

renderMarkers();
</script>


</body></html>
