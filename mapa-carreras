// Load saved coords from localStorage
const savedCoords = JSON.parse(localStorage.getItem('map_coords') || '{}');

function getCoord(r) {
  const key = r.loc;
  if(savedCoords[key]) return savedCoords[key];
  return [r.lat, r.lng];
}

// Date helpers
const MONTH_LABELS = ['','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
function doyToLabel(doy) {
  if(doy >= 366) return '31 Dic';
  if(doy <= 1) return '1 Ene';
  const months = [0,31,28,31,30,31,30,31,31,30,31,30,31];
  let m=1, d=doy;
  while(m<=12 && d>months[m]){d-=months[m];m++;}
  if(m>12) return '31 Dic';
  return `${d} ${MONTH_LABELS[m]}`;
}

