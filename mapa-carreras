*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f8f8f8;height:100vh;display:flex;flex-direction:column}
.topbar{background:#fff;border-bottom:1px solid #e0e0e0;padding:10px 14px;flex-shrink:0}
.topbar-row1{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.map-title{font-size:16px;font-weight:600;color:#111;margin-right:4px}
.toggle-group{display:flex;border:1px solid #ddd;border-radius:20px;overflow:hidden}
.toggle-btn{font-size:11px;font-weight:600;padding:4px 12px;background:#fff;color:#777;border:none;cursor:pointer;transition:all .15s;white-space:nowrap}
.toggle-btn.active{background:#222;color:#fff}
.edit-btn{font-size:11px;font-weight:600;padding:4px 12px;border-radius:20px;border:1px solid #ddd;background:#fff;color:#777;cursor:pointer;transition:all .15s;white-space:nowrap}
.edit-btn.active{background:#e65100;color:#fff;border-color:#e65100}
.map-stats{font-size:11px;color:#aaa;margin-left:auto}
.map-stats strong{color:#555}
.slider-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.slider-label{font-size:11px;color:#888;white-space:nowrap;min-width:90px}
.slider-wrap{flex:1;min-width:200px;position:relative;height:20px}
.slider-track{position:absolute;top:8px;left:0;right:0;height:4px;background:#e0e0e0;border-radius:2px}
.slider-fill{position:absolute;top:8px;height:4px;background:#222;border-radius:2px}
input[type=range]{position:absolute;width:100%;height:4px;top:8px;left:0;appearance:none;background:transparent;pointer-events:none}
input[type=range]::-webkit-slider-thumb{appearance:none;width:16px;height:16px;border-radius:50%;background:#222;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.3);pointer-events:all;cursor:pointer}
input[type=range]::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:#222;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.3);pointer-events:all;cursor:pointer}
#map{flex:1}
.edit-panel{position:absolute;top:10px;right:10px;z-index:1000;background:#fff;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.15);padding:14px;width:260px;display:none;font-size:12px}
.edit-panel.visible{display:block}
.edit-panel h4{font-size:13px;font-weight:600;color:#111;margin-bottom:8px}
.edit-panel p{color:#777;margin-bottom:10px;line-height:1.5}
.edit-coords{background:#f5f5f5;border-radius:6px;padding:8px;font-family:monospace;font-size:11px;color:#333;margin-bottom:8px;word-break:break-all}
.btn-copy{width:100%;padding:7px;background:#222;color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer}
.btn-copy:hover{background:#444}
.legend{position:absolute;bottom:24px;left:10px;z-index:1000;background:rgba(255,255,255,.95);padding:8px 12px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.12);font-size:11px}
.legend-item{display:flex;align-items:center;gap:6px;margin-bottom:3px;color:#555}
.legend-item:last-child{margin-bottom:0}
.legend-dot{width:9px;height:9px;border-radius:50%}
.popup-title{font-size:13px;font-weight:600;color:#111;margin-bottom:3px}
.popup-sub{font-size:11px;color:#888;margin-bottom:7px}
.popup-race{font-size:11px;padding:3px 0;border-bottom:1px solid #f0f0f0;display:flex;gap:5px;align-items:baseline}
.popup-race:last-child{border-bottom:none}
.popup-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:2px}
.popup-rname{flex:1;color:#333;font-weight:500}
.popup-date{color:#aaa;font-size:10px;white-space:nowrap}
.popup-dist{font-size:10px;padding:1px 5px;border-radius:6px;background:#f0f0f0;color:#666;white-space:nowrap}
.popup-link{display:block;font-size:11px;color:#1565c0;margin-top:5px;text-decoration:none}
.popup-link:hover{text-decoration:underline}
