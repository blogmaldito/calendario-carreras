  {name:"MITJA COLOMENCA",loc:"Santa Coloma G.",dist:"21k · 10k",date:"07/02",month:"Febrero",doy:38,certified:true,confirmed:false,web:"https://uca.cat/categoria/curses/mitja-marato-colomenca/",guideUrl:"https://wp.me/pNuBu-q7D"},
  {name:"MITJA DE BARCELONA",loc:"Barcelona",dist:"21k",date:"14/02",month:"Febrero",doy:45,certified:true,confirmed:true,web:"https://www.mitjamarato.barcelona/",guideUrl:"https://wp.me/pNuBu-q1Y"},
  {name:"MITJA DE TERRASSA",loc:"Terrassa",dist:"21k · 5k",date:"28/02",month:"Febrero",doy:59,certified:true,confirmed:true,web:"https://www.mitjaterrassa.org/curses/mitja-marato/",guideUrl:"https://wp.me/pNuBu-pSr"},
  {name:"MITJA DE CAMBRILS",loc:"Cambrils",dist:"21k · 10k",date:"28/02",month:"Febrero",doy:59,certified:false,confirmed:true,web:"https://mitjadecambrils.com/",guideUrl:"https://wp.me/pNuBu-q9w"},
  {name:"MITJA DE GIRONA",loc:"Girona",dist:"21k · 10k",date:"28/02",month:"Febrero",doy:59,certified:true,confirmed:true,web:"https://mitjamaratogirona.cat/",guideUrl:""},
  {name:"MITJA GARROTXA",loc:"Olot",dist:"21k · 10k",date:"07/03",month:"Marzo",doy:66,certified:true,confirmed:false,web:"http://www.cnolot.cat/catalan/esdeveniments-mitja-marato",guideUrl:"https://wp.me/pNuBu-bX8"},
  {name:"MITJA DE BALAGUER",loc:"Balaguer",dist:"21k · 10k · 5k",date:"07/03",month:"Marzo",doy:66,certified:true,confirmed:false,web:"https://www.runners.cat/",guideUrl:"https://wp.me/pNuBu-gma"},
  {name:"MITJA DE RAMS",loc:"Vic",dist:"21k · 5k",date:"21/03",month:"Marzo",doy:80,certified:true,confirmed:false,web:"https://www.lamitjaderams.cat/",guideUrl:"https://wp.me/pNuBu-qqL"},
  {name:"MITJA PLA DE L'ESTANY",loc:"Banyoles",dist:"21k · 6k",date:"04/04",month:"Abril",doy:94,certified:true,confirmed:true,web:"https://cnbanyoles.cat/competicions/mitja-marato-del-pla-de-lestany/",guideUrl:"https://wp.me/pNuBu-nQL"},
  {name:"MITJA MIAMI PLATJA",loc:"Montroig del Camp",dist:"21k · 10k · 5k",date:"04/04",month:"Abril",doy:94,certified:false,confirmed:false,web:"https://webtretzesports.wixsite.com/mitjamiamiplatja",guideUrl:""},
  {name:"MITJA DE MONTORNÈS",loc:"Montornès",dist:"21k · 6k",date:"11/04",month:"Abril",doy:101,certified:true,confirmed:false,web:"https://mitjamontornes.com/",guideUrl:"https://wp.me/pNuBu-nPO"},
  {name:"MITJA D'EMPÚRIES",loc:"L'Escala",dist:"21k · 42k · 10k ·5k",date:"18/04",month:"Abril",doy:108,certified:true,confirmed:false,web:"https://esportslescala.cat/marato-dempuries/",guideUrl:""},
  {name:"MITJA DEL MEDITERRANI",loc:"Castelldefels",dist:"21k · 10k · 5k",date:"25/04",month:"Abril",doy:115,certified:true,confirmed:true,web:"https://www.zonavipevents.com/marato-del-mediterrani/",guideUrl:"https://wp.me/pNuBu-qN3"},
  {name:"MITJA MARATÓ VIES VERDES",loc:"Girona / Platja D'Aro",dist:"42k · 30k · 21k · 10k",date:"25/04",month:"Abril",doy:115,certified:false,confirmed:false,web:"https://maratonviasverdes.com/ca/girona",guideUrl:""},
  {name:"MITJA DE TÀRREGA",loc:"Tàrrega",dist:"21k · 10k",date:"09/05",month:"Mayo",doy:129,certified:false,confirmed:false,web:"https://fondistestarrega.com/ca/pc/2-mitja-marato-i-10-km-ciutat-de-tarrega",guideUrl:"https://wp.me/pNuBu-o1H"},
  {name:"21K LO CARO",loc:"Tortosa",dist:"21k ·10k",date:"16/05",month:"Mayo",doy:136,certified:true,confirmed:false,web:"http://www.21kloport.cat/es/inicio/",guideUrl:""},
  {name:"RUN FESTIVAL TOSSA DE MAR",loc:"Tossa de Mar",dist:"21k · 42k · 10k ·5k",date:"16/05",month:"Mayo",doy:136,certified:true,confirmed:true,web:"https://runfestivaltossa.com/",guideUrl:"https://wp.me/pNuBu-l6k"},
  {name:"MITJA RURAL DE REUS",loc:"Reus",dist:"21k · 10k",date:"30/05",month:"Mayo",doy:150,certified:false,confirmed:false,web:"https://webtretzesports.wixsite.com/mitjaruralreus",guideUrl:""},
  {name:"MITJA DE MOLLERUSSA",loc:"Mollerussa",dist:"21k · 5k",date:"18/10",month:"Octubre",doy:291,certified:true,confirmed:true,web:"https://sites.google.com/mollerussa.cat/mitjamollerussa/",guideUrl:""},
  {name:"MITJA DE VILA-SECA",loc:"Vila-Seca",dist:"21k · 10k · 5k",date:"18/10",month:"Octubre",doy:291,certified:true,confirmed:true,web:"https://www.runnersvilaseca.com/lamedia",guideUrl:"https://wp.me/pNuBu-oXn"},
  {name:"MITJA DE PUIGCERDÀ",loc:"Puigcerdà",dist:"21k · 10k",date:"18/10",month:"Octubre",doy:291,certified:false,confirmed:true,web:"https://www.puigcerda.cat/ca/serveis/esports/28a-mitja-marato-de-puigcerda-by-bwt-2026/",guideUrl:"https://wp.me/pNuBu-oO7"},
  {name:"MITJA VENDRELL",loc:"Coma-ruga",dist:"21k · 10k · 5k",date:"25/10",month:"Octubre",doy:298,certified:true,confirmed:true,web:"https://mitjavendrell.runnerselvendrell.cat/",guideUrl:"https://wp.me/pNuBu-p0z"},
  {name:"MITJA COSTA BARCELONA - MARESME",loc:"Calella",dist:"21k",date:"25/10",month:"Octubre",doy:298,certified:true,confirmed:true,web:"https://gesport.cat/mitja-marato-costa-barcelona-maresme-2026/",guideUrl:"https://wp.me/pNuBu-oO7"},
  {name:"MITJA DE TARRAGONA",loc:"Tarragona",dist:"21k · 10k",date:"08/11",month:"Noviembre",doy:312,certified:true,confirmed:true,web:"https://www.mitjatarragona.cat/es/",guideUrl:"https://wp.me/pNuBu-oWQ"},
  {name:"MITJA DE LLEIDA",loc:"Lleida",dist:"21k · 5k",date:"15/11",month:"Noviembre",doy:319,certified:false,confirmed:true,web:"https://mitjalleida.com/",guideUrl:""},
  {name:"MITJA DE RIPOLL",loc:"Ripoll",dist:"21k · 10k · 5k",date:"15/11",month:"Noviembre",doy:319,certified:false,confirmed:false,web:"https://www.mitjamarato.cat/",guideUrl:""},
  {name:"MITJA DANI DEL MARESME",loc:"Figueres",dist:"21k · 10k · 6k",date:"22/11",month:"Noviembre",doy:326,certified:true,confirmed:true,web:"https://lacursadani.com/service/cursa-dani-maresme/",guideUrl:"https://wp.me/pNuBu-p91"},
  {name:"MITJA DE L'ESPIRALL",loc:"Vilafranca",dist:"21k · 5k",date:"22/11",month:"Noviembre",doy:326,certified:true,confirmed:true,web:"https://mitja.vilafranca.cat/",guideUrl:"https://wp.me/pNuBu-p9o"},
  {name:"MITJA GAVÀ",loc:"Gavà",dist:"21k",date:"22/11",month:"Noviembre",doy:326,certified:true,confirmed:true,web:"https://www.instagram.com/mitjagava/?hl=es",guideUrl:"https://wp.me/pNuBu-oXw"},
  {name:"MITJA DE FIGUERES",loc:"Figueres",dist:"21k · 10k",date:"06/12",month:"Diciembre",doy:340,certified:true,confirmed:true,web:"https://www.instagram.com/mitjafigueres/?hl=es",guideUrl:"https://wp.me/pNuBu-gWe"},
  {name:"MITJA DE VILANOVA",loc:"Vilanova i G.",dist:"21k · 10k",date:"13/12",month:"Diciembre",doy:347,certified:true,confirmed:true,web:"http://mitjavilanova.com/",guideUrl:"https://wp.me/pNuBu-pkH"},
  {name:"MITJA BADIA DE ROSES",loc:"Roses",dist:"21k · 7,5k",date:"27/12",month:"Diciembre",doy:361,certified:false,confirmed:false,web:"https://www.atletismeroses.cat/mitjabadiaderoses",guideUrl:""}
];

const monthOrder=["Octubre","Noviembre","Diciembre","Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre"];
let activeMonth="Todos";

function render(){
  const list=document.getElementById("race-list");
  const filtered=activeMonth==="Todos" ? races : races.filter(r=>r.month===activeMonth);
  const confirmed=filtered.filter(r=>r.confirmed).length;
  const withGuide=filtered.filter(r=>r.guideUrl).length;
  document.getElementById("stat-total").innerHTML=`<strong>${filtered.length}</strong> carreras`;
  document.getElementById("stat-confirmed").innerHTML=`<strong style="color:#2e7d32">${confirmed}</strong> confirmadas`;
  document.getElementById("stat-guide").innerHTML=`<strong style="color:#1565c0">${withGuide}</strong> con guía`;
  if(!filtered.length){list.innerHTML='<div class="empty-state">No hay carreras con estos filtros</div>';return;}
  const byMonth={};
  filtered.forEach(r=>{if(!byMonth[r.month])byMonth[r.month]=[];byMonth[r.month].push(r);});
  const orderedMonths=monthOrder.filter(m=>byMonth[m]);
  list.innerHTML=orderedMonths.map(m=>{
    const rs=byMonth[m];
    return `<div class="month-block">
      <div class="month-label">${m} · ${rs.length} carrera${rs.length!==1?'s':''}</div>
      ${rs.map((r,i)=>{
        const id=`r${m.slice(0,3)}${i}`;
        return `<div class="race-item">
          <div class="race-header" onclick="toggle('${id}')">
            <div class="race-status ${r.confirmed?'status-confirmed':'status-pending'}"></div>
            <div class="race-content">
              <div class="race-name">${r.name}</div>
              <div class="race-meta">
                <span class="race-loc">${r.loc}</span>
                <span class="race-date">${r.date}</span>
                <span class="race-dist">${r.dist}</span>
              </div>
            </div>
            <svg class="chevron" id="chev${id}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6l4 4 4-4"/></svg>
          </div>
          <div class="race-details" id="${id}">
            <div class="detail-item"><span class="detail-label">Homologada</span>${r.certified?"Sí":"No"}</div>
            <div class="detail-item"><span class="detail-label">Estado</span>${r.confirmed?"Confirmada":"Pendiente"}</div>
            <div class="detail-links">
              ${r.web?`<a class="detail-link" href="${r.web}" target="_blank" rel="noopener">Web oficial ↗</a>`:''}
              ${r.guideUrl?`<a class="guide-badge" href="${r.guideUrl}" target="_blank" rel="noopener">Guía del recorrido ↗</a>`:''}
            </div>
          </div>
        </div>`;
      }).join('')}
    </div>`;
  }).join('');
}

function toggle(id){
  const el=document.getElementById(id);
  const chev=document.getElementById("chev"+id);
  const open=el.style.display==="grid";
  el.style.display=open?"none":"grid";
  chev.classList.toggle("open",!open);
}

function buildFilters(){
  const months=["Todos",...monthOrder.filter(m=>races.some(r=>r.month===m))];
  document.getElementById("month-filters").innerHTML=months.map(m=>
    `<button class="filter-btn${m==="Todos"?" active":""}" onclick="setMonth('${m}')">${m}</button>`
  ).join('');
}

function setMonth(m){
  activeMonth=m;
  document.querySelectorAll("#month-filters .filter-btn").forEach(b=>b.classList.toggle("active",b.textContent===m));
  render();
}

buildFilters();render();
</script>
</body>
</html>
